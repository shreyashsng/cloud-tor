# Cloud-Tor Server Configuration
PORT=3000
NODE_ENV=production
PUBLIC_URL=http://localhost:3000
TOR_CRED=your_admin_secret_password_here

# Backblaze B2 Cloud Storage Configuration (S3-Compatible)
B2_APPLICATION_KEY_ID=your_backblaze_key_id_here
B2_APPLICATION_KEY=your_backblaze_application_key_here
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_BUCKETS=webt-temp
STORAGE_RETENTION_HOURS=6

# Maximum allowed file size for cloud download (5GB = 5368709120 bytes)
MAX_FILE_SIZE_BYTES=5368709120

# Upstash Redis Cache (REST API)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Turso Database (libSQL over HTTP)
TURSO_DATABASE_URL=https://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_token_here
